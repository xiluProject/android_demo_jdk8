# 签名配置模板：复制本文件为 keystore.properties 后按需修改。
# keystore.properties 已被 .gitignore 忽略（不会提交），本模板保留在仓库里供参考格式。
# 本文件由 app/build.gradle 的 signingConfigs 读取，值请使用纯英文/数字，不要加引号。

# 签名文件路径（相对工程根目录）
MYAPP_RELEASE_STORE_FILE=app/keystore/xilu_release.keystore
# 签名文件别名
MYAPP_RELEASE_KEY_ALIAS=release
# 签名文件密码
MYAPP_RELEASE_STORE_PASSWORD=your_store_password
# 别名密码
MYAPP_RELEASE_KEY_PASSWORD=your_key_password
